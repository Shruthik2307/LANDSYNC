# LANDSYNC environment template — copy to .env (frontend) and backend/.env as needed.

# ── Frontend → API base URL ────────────────────────────────────────────────
# • Production (single-service Railway deploy): leave EMPTY — the FastAPI app
#   serves both the SPA and every /api/* route from ONE origin.
# • Local dev with `npm run dev:backend`: leave EMPTY — Vite proxies /api to
#   127.0.0.1:8000 (see vite.config.js).
# • Only set this when the frontend is hosted separately from the API.
VITE_API_BASE_URL=

VITE_ENABLE_SATELLITE_OVERLAY=true
# CARTO raster basemap key (removes the "API key required" watermark).
VITE_CARTO_API_KEY=
# Optional Sentinel Hub instance ID. Leave empty to use cached local imagery only.
VITE_SENTINELHUB_INSTANCE_ID=

# ── Backend ────────────────────────────────────────────────────────────────
# Optional: the backend defaults to sqlite:///./landsync.db.
# For production use PostgreSQL with PostGIS (see backend/.env.example):
# DATABASE_URL=postgresql://landsync:landsync@localhost:5432/landsync

# Sentinel Hub Credentials (Backend Only)
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
