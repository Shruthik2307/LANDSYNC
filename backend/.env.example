# Database Configuration
# For development, SQLite is used by default: sqlite:///./landsync.db
# For production, use PostgreSQL with PostGIS:
DATABASE_URL=postgresql://landsync:landsync@localhost:5432/landsync

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging
LOG_LEVEL=INFO

# File Upload Settings
MAX_UPLOAD_SIZE_MB=100

# Tile Provider (esri or sentinel)
SATELLITE_TILE_PROVIDER=esri
